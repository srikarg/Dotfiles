# Compiled Python files
*.pyc

# Folder view configuration files
.DS_Store
Desktop.ini

# Thumbnail cache files
._*
Thumbs.db

# Files that might appear on external disks
.Spotlight-V100
.Trashes

# Extra environment variables/configuration that is machine specific
.extra

# LazyGit state/cache files
/lazygit/.config/lazygit/state.yml
/lazygit/.config/lazygit/github_pull_requests.json

# herdr runtime/state
/herdr/.config/herdr/*.log
/herdr/.config/herdr/session.json
/herdr/.config/herdr/.plugins.lock
/herdr/.config/herdr/release-notes.json

# Worktrunk command approvals state
/worktrunk/.config/worktrunk/approvals.toml*

# Ignore everything in custom scripts directory except .local/scripts
#
# This is needed as the ~/.local folder might have other folders outside of the
# custom scripts one we are adding via a GNU Stow alias
!/custom-scripts/
/custom-scripts/**
!/custom-scripts/\.local/
!/custom-scripts/\.local/scripts/
!/custom-scripts/\.local/scripts/*
